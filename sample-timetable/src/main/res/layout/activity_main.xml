<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面 = 抽屉式布局。

  设计原则（「高级简洁」）：
   · 主屏**只放天天要看的**：下一节课 / 本周课表 / 上课提醒 —— 干净、无按钮噪音
   · 所有实验性、一次性、技术性的功能（试 A/B/C、试 M、诊断、悬浮岛预览、通知设置…）
     全部收进**左侧栏**，需要时才拉开
   · 卡片统一 20dp 圆角 + 1px 描边 + 无阴影；强调色只用在"还剩多久"和选中项上
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ==================== 主内容 ==================== -->
    <LinearLayout
        android:id="@+id/rootMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：菜单 + 品牌 + 今天的状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="打开侧栏"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.03"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text=""
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <!-- 下一节课 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/IslandCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chipStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip_neutral"
                                android:paddingStart="11dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="11dp"
                                android:paddingBottom="4dp"
                                android:text="下一节"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvNowRange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNowState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:letterSpacing="0.12"
                            android:text="接下来"
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:letterSpacing="0.01"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="—"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressNow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            app:trackCornerRadius="3dp"
                            app:trackThickness="5dp" />

                        <TextView
                            android:id="@+id/tvNowRemain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="—"
                            android:textColor="@color/accent"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 本周课表 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/IslandCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/SectionLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="本周课表" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWeekPrev"
                                style="@style/SmallButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingStart="13dp"
                                android:paddingEnd="13dp"
                                android:text="＜" />

                            <TextView
                                android:id="@+id/tvWeekBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:layout_marginEnd="7dp"
                                android:text="第 1 周"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnWeekNext"
                                style="@style/SmallButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:paddingStart="13dp"
                                android:paddingEnd="13dp"
                                android:text="＞" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTimetableInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text=""
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />

                        <dev.dpvoliin.islandtimetable.TimetableGridView
                            android:id="@+id/gridView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 上课提醒 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/IslandCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/SectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="上课提醒" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchReminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="提前提醒（只提醒当前周次真实存在的课）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLead0"
                                style="@style/SmallButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="准点" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLead5"
                                style="@style/SmallButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="5 分" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLead10"
                                style="@style/SmallButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="10 分" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLead15"
                                style="@style/SmallButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:text="15 分" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvReminderHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:lineSpacingExtra="3dp"
                            android:text=""
                            android:textColor="@color/text_tertiary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ==================== 侧栏 ==================== -->
    <ScrollView
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/drawerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="26dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">

            <View
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_brand_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.03"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <!-- 通知测试 -->
            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="通知" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFull"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="开启通知" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinish"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="关闭通知" />

            <!-- 设置 -->
            

            <!-- 悬浮岛 -->
            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="悬浮岛" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlay"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="悬浮岛预览 / 收起" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoIsland"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="自动选择：能用系统实时通知就不启用悬浮岛"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 课表 -->
            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="课表" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="导入课表（Excel / CSV / JSON / ICS）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeekFix"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="周次对不上？修正「现在是第几周」" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJwxt"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="教务直连 · 正方（需联网）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeriods"
                style="@style/ActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="修改上课时间（作息时间表）" />

<TextView
                android:id="@+id/tvSettingsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_hint"
                android:drawablePadding="6dp"
                android:padding="12dp"
                android:text="▾  设置（点展开）"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/settingsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrash"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="上次崩溃日志（点开可复制）"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTheme"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="主题：跟随系统" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNotifSettings"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="通知设置" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchReminderVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="上课提醒震动（不响铃）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoSilent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="上课自动静音（下课自动恢复）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalendar"
                style="@style/ActionButton.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="写入系统日历（整学期）" />



            
              <TextView
                  style="@style/SectionLabel"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="22dp"
                  android:text="后台与通知存活" />

              <TextView
                  android:id="@+id/tvAliveStatus"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:lineSpacingExtra="3dp"
                  android:text=""
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp" />

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:orientation="horizontal">

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/btnAliveCheck"
                      style="@style/SmallButton"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_weight="1"
                      android:text="立即检查" />

                  <com.google.android.material.button.MaterialButton
                      android:id="@+id/btnBatteryOpt"
                      style="@style/SmallButton"
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:layout_weight="1"
                      android:text="电池优化" />
              <com.google.android.material.button.MaterialButton
                  android:id="@+id/btnAppInfo"
                  style="@style/SmallButton"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:layout_weight="1"
                  android:text="应用信息" />
              </LinearLayout>


              <com.google.android.material.materialswitch.MaterialSwitch
                  android:id="@+id/switchAlive"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8dp"
                  android:text="推送通知时用前台服务保活（推荐）"
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp" />

              <com.google.android.material.materialswitch.MaterialSwitch
                  android:id="@+id/switchSticky"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="常驻通知（划不掉，常显当前课/下一节）"
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp" />

              <com.google.android.material.materialswitch.MaterialSwitch
                  android:id="@+id/switchStickyDedupe"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="有实时通知时自动隐藏常驻（默认关）"
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp" />
        </LinearLayout>

            <!-- 后台与通知存活 -->
            


                            <!-- 关于：库 / 使用的开源库 / 免责声明（可折叠，与「设置」同一样式） -->
        <TextView
            android:id="@+id/tvAboutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_hint"
            android:padding="10dp"
            android:text="▾  关于（点展开）"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aboutBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="岛课表"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="liveupdates（本项目开源库模块 · MIT）"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="使用的开源库（第三方）"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:text="· AndroidX AppCompat 1.7.0（Apache-2.0）\n· Google Material Components 1.12.0（Apache-2.0）\n· AndroidX Core / DrawerLayout / Transition（Apache-2.0）\n· 除以上外，未引入任何第三方库"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="免责声明"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
