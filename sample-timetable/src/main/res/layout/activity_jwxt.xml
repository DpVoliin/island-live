<?xml version="1.0" encoding="utf-8"?>
<!--
  教务直连（正方 / 其它教务）。

  版式约定：**把网页留大**。
    · 最上面是网址行（输入 + 打开）
    · 紧跟一个常驻按钮「抓取课表（正方接口）」—— 正方用户的核心动作，不该藏
    · 其余动作收进可折叠的「操作」面板（默认收起），需要时点开
    · 中间只留一行状态，底下 WebView 占满剩余高度

  （踩过的坑：把按钮竖着堆满一屏，WebView 被压到看不见；分组标签又用了 match_parent，
   在横向容器里会吃满整行把兄弟挤出屏幕 —— 所以这版结构全部是纵向、宽度只用 match_parent
   或 0dp+weight，不给"挤没"留机会。）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootJwxt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/etJwxtUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="教务系统网址（含 https://）"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtOpen"
            style="@style/ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="64dp"
            android:text="打开" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnJwxtFetch"
        style="@style/ActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:text="抓取课表（正方接口）" />

    <TextView
        android:id="@+id/tvJwxtActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_hint"
        android:padding="10dp"
        android:text="操作 ▾ 点开（其它教务 / 复制 / 自检）"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/jwxtActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="其它教务（强智 / 青果 / URP / 老正方 —— 读 HTML 表格）"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtCurrentPage"
            style="@style/ActionButton.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="抓取当前页（表格）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtWholeTerm"
            style="@style/ActionButton.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="抓取整学期课表（自动识别 / 自动切页）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtSweep"
            style="@style/ActionButton.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="逐周扫描（页面只能看单周时用，约 1 分钟）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtCopy"
            style="@style/ActionButton.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="复制原始" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJwxtSample"
            style="@style/ActionButton.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="解析器自检" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvJwxtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <WebView
        android:id="@+id/webJwxt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />
</LinearLayout>
